{
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "./dist",

    // CommonJS output (package.json has no "type": "module"), which keeps Jest simple
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node", "jest"],
    "esModuleInterop": true,

    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "../shared"],
  "exclude": ["src/**/*.test.ts"]
}
